{
  "name": "sandbox-hello-world-direct-api",
  "edges": [
    {
      "from": "start",
      "to": "create_sandbox"
    },
    {
      "from": "create_sandbox",
      "to": "wait_for_exit"
    },
    {
      "from": "wait_for_exit",
      "to": "read_output"
    },
    {
      "from": "read_output",
      "to": "delete_sandbox"
    }
  ],
  "nodes": [
    {
      "id": "create_sandbox",
      "name": "Create hello-world Sandbox",
      "type": "http_request",
      "position": {
        "x": 250.0,
        "y": 200.0
      },
      "settings": {
        "timeout": 30,
        "retry_policy": {
          "max_retries": 0
        }
      },
      "parameters": {
        "url": "https://kubernetes.default.svc/apis/agents.x-k8s.io/v1beta1/namespaces/agent-sandboxes/sandboxes",
        "body": {
          "apiVersion": "agents.x-k8s.io/v1beta1",
          "kind": "Sandbox",
          "metadata": {
            "name": "ao-hello-${workflow_context.execution.id}",
            "namespace": "agent-sandboxes",
            "labels": {
              "app.kubernetes.io/name": "ao-hello-prototype",
              "app.kubernetes.io/managed-by": "automation-orchestrator"
            }
          },
          "spec": {
            "service": false,
            "shutdownPolicy": "Delete",
            "podTemplate": {
              "metadata": {
                "labels": {
                  "app.kubernetes.io/name": "ao-hello-prototype"
                }
              },
              "spec": {
                "serviceAccountName": "sandbox",
                "automountServiceAccountToken": false,
                "restartPolicy": "Never",
                "activeDeadlineSeconds": 120,
                "securityContext": {
                  "runAsNonRoot": true,
                  "seccompProfile": {
                    "type": "RuntimeDefault"
                  }
                },
                "containers": [
                  {
                    "name": "workspace",
                    "image": "registry.access.redhat.com/ubi9/python-312@sha256:608649675c344ac80d58842b883515f39a2232398386805bc6a741f823340a4e",
                    "command": [
                      "/bin/bash",
                      "-ec",
                      "echo hello world"
                    ],
                    "securityContext": {
                      "allowPrivilegeEscalation": false,
                      "readOnlyRootFilesystem": true,
                      "capabilities": {
                        "drop": [
                          "ALL"
                        ]
                      }
                    },
                    "resources": {
                      "requests": {
                        "cpu": "10m",
                        "memory": "32Mi"
                      },
                      "limits": {
                        "cpu": "100m",
                        "memory": "128Mi"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "credential_id": "bd7fed92-4cf7-4989-8559-ac07f9e0ce53"
      }
    },
    {
      "id": "wait_for_exit",
      "name": "Wait for sandbox command",
      "type": "wait",
      "position": {
        "x": 500.0,
        "y": 200.0
      },
      "parameters": {
        "duration": 10
      }
    },
    {
      "id": "read_output",
      "name": "Read sandbox output",
      "type": "http_request",
      "position": {
        "x": 750.0,
        "y": 200.0
      },
      "settings": {
        "timeout": 30,
        "retry_policy": {
          "max_retries": 0
        },
        "continue_on_failure": true
      },
      "parameters": {
        "url": "https://kubernetes.default.svc/api/v1/namespaces/agent-sandboxes/pods/ao-hello-${workflow_context.execution.id}/log",
        "method": "GET",
        "query_params": {
          "container": "workspace"
        },
        "credential_id": "bd7fed92-4cf7-4989-8559-ac07f9e0ce53"
      }
    },
    {
      "id": "delete_sandbox",
      "name": "Delete Sandbox",
      "type": "http_request",
      "position": {
        "x": 1000.0,
        "y": 200.0
      },
      "settings": {
        "timeout": 30,
        "retry_policy": {
          "max_retries": 0
        },
        "continue_on_failure": true
      },
      "parameters": {
        "url": "https://kubernetes.default.svc/apis/agents.x-k8s.io/v1beta1/namespaces/agent-sandboxes/sandboxes/ao-hello-${workflow_context.execution.id}",
        "method": "DELETE",
        "credential_id": "bd7fed92-4cf7-4989-8559-ac07f9e0ce53"
      }
    }
  ],
  "triggers": [
    {
      "id": "start",
      "name": "Run prototype",
      "type": "manual_trigger",
      "position": {
        "x": 0,
        "y": 200
      },
      "parameters": {
        "input_schema": {
          "type": "object",
          "properties": {}
        }
      }
    }
  ],
  "description": "Create a one-shot Agent Sandbox through the Kubernetes API, read its hello-world log, and delete it.",
  "schema_version": "2.0.0"
}

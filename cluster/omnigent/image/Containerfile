FROM ghcr.io/omnigent-ai/omnigent-host@sha256:f3dee09609ccecbebd6841c30b33f0160eaf3d2758d535b2e3993c1a3df5664a

RUN /opt/venv/bin/python -m venv /opt/ansible-dev-tools \
    && /opt/ansible-dev-tools/bin/python -m pip install --no-cache-dir \
        ansible-core==2.21.4 \
        ansible-dev-tools==26.9.0 \
        ansible-lint==26.9.0 \
    && /opt/ansible-dev-tools/bin/python -m pip check \
    && /opt/venv/bin/python -m pip check

ENV PATH="${PATH}:/opt/ansible-dev-tools/bin"

RUN npm install --global opencode-ai@1.18.32

COPY opencode-profile.sh /etc/profile.d/omnigent-opencode.sh
RUN bash -lc 'command -v ansible && command -v molecule && command -v pytest'

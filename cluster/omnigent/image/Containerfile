FROM ghcr.io/ansible/community-ansible-dev-tools@sha256:775c81d53058009dd47b97872f4a86d3b0a9ce16ad9af3cc48514ce4197aa787

# Keep Omnigent's dependencies separate from the Ansible tools in the base image.
RUN dnf5 install -y bubblewrap nodejs npm tmux \
    && dnf5 clean all \
    && /usr/bin/python3 -m pip install --no-cache-dir kubernetes==35.0.0 boto3==1.43.113 botocore==1.43.113 \
    && /usr/bin/python3 -m pip check \
    && /usr/bin/python3 -m venv /opt/omnigent \
    && /opt/omnigent/bin/python -m pip install --no-cache-dir omnigent==0.15.0 \
    && /opt/omnigent/bin/python -m pip check

ENV PATH="${PATH}:/opt/omnigent/bin"
ENV MOLECULE_GLOB="extensions/molecule/*/molecule.yml"
ENV ANSIBLE_COLLECTIONS_PATH="~/.ansible/collections:/usr/share/ansible/collections"

COPY requirements.yml /opt/omnigent/requirements.yml
# Verify the published Galaxy artifact before preloading the exact test pin.
RUN ansible-galaxy collection download david_igou.molecule_provisioners:0.0.7-alpha \
        --no-deps --download-path /tmp/molecule-provisioners \
    && echo 'efe5f587332ef7f744537c9ab7779856470725d0b85463778a633aa28d8b7440  /tmp/molecule-provisioners/david_igou-molecule_provisioners-0.0.7-alpha.tar.gz' | sha256sum --check \
    && ansible-galaxy collection install --no-deps \
        /tmp/molecule-provisioners/david_igou-molecule_provisioners-0.0.7-alpha.tar.gz -p /usr/share/ansible/collections \
    && rm -rf /tmp/molecule-provisioners
RUN ansible-galaxy collection install \
        -r /opt/omnigent/requirements.yml \
        -p /usr/share/ansible/collections

RUN npm install --global opencode-ai@1.18.32

COPY opencode-profile.sh /etc/profile.d/omnigent-opencode.sh
COPY sandbox-user-profile.sh /etc/profile.d/00-sandbox-user.sh
COPY molecule-profile.sh /etc/profile.d/molecule.sh
COPY demo-goldenpath.py /usr/local/bin/demo-goldenpath
RUN chmod 755 /usr/local/bin/demo-goldenpath \
    && bash -lc 'command -v omnigent && command -v bwrap && command -v tmux && command -v ansible && command -v molecule && command -v make && command -v opencode && command -v git && command -v ssh && command -v ssh-keygen && command -v demo-goldenpath' \
    && /usr/bin/python3 -c 'import kubernetes, boto3, botocore'

# Local secrets and configuration. Copy to .env and keep values out of Git.
# Bash-compatible: quote values; single quotes keep $, spaces, and # literal.
# Load from the repo root: set -a; source .env; set +a

# Demo cluster access: path only, never paste kubeconfig contents here.
KUBECONFIG="$HOME/.kube/config"
EXPECTED_SERVER=''
FORGEJO_URL=''

# Bootstrap / demo-reset: your OpenCode Go subscription key.
MODEL_API_KEY=''
# Leave model overrides unset to use the scripts' OpenCode Go / gpt-6-luna defaults.
# MODEL_BASE_URL='https://opencode.ai/zen/go/v1'
# MODEL_NAME='gpt-6-luna'

# AAP config-as-code: URL is discovered from the cluster when left blank.
AAP_HOST=''
AAP_USERNAME='admin'
AAP_PASSWORD=''
# The EE defaults to the BuildConfig's internal demo-aap-ee:latest image.
# AAP_EE_IMAGE=''

# AAP SCM / direct Forgejo API calls.
# For AAP use the hydration-generated demo-agent token from:
# cluster/forgejo-demo/.state/<ingress-domain>/agent-token
# Admin-only Forgejo API calls require the admin-token instead.
FORGEJO_TOKEN=''

# VM admin: mint from aap-vm-admin in automation-vms after deploying the PR.
# The same token is used for VM inventory discovery and deployment.
# These inputs are discovered/minted by make aap-configure when left blank.
# Tokens expire after eight hours; rerun configuration to renew them.
K8S_AUTH_HOST=''
K8S_AUTH_API_KEY=''
# Public CA certificate CONTENTS for the AAP credential; multiline quotes work.
AAP_K8S_CA_CERT=''
# Local navigator VM runs: absolute path to the public CA certificate FILE.
# Do not set K8S_AUTH_CA_CERT to certificate contents.
K8S_AUTH_SSL_CA_CERT=''

# EE builds and pushes run in OpenShift with the cluster's registry credentials.
# No local registry login or base image value is required.

# Optional direct Forgejo webhook configuration; AO's normal workflow omits it.
WEBHOOK_SECRET=''

# AAP subscription manifest: place aap_manifest.zip in this repo's root.
# Source this file from the repo root so the absolute path survives directory changes.
# make aap-configure imports it through infra.aap_configuration before dispatch.
AAP_LICENSE_FILE="$PWD/aap_manifest.zip"

# Bootstrap/operators generate database, AO/Omnigent machine, and app credentials.
# Hydration generates Forgejo/Backstage tokens. Those flows continue managing
# their Kubernetes Secrets and local .state files. AAP shortcuts load this file;
# source it explicitly before the other bootstrap/demo scripts.

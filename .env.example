# Copy to .env (gitignored), chmod 600 .env, and populate operator-owned inputs.
# All bootstrap/demo entry points load this file automatically.
# Export KUBECONFIG in your shell, or uncomment an explicit path here.
# A nonempty inherited KUBECONFIG takes precedence over this file.
# KUBECONFIG="$HOME/.kube/config"
BOOTSTRAP_BRANCH=''
# GitHub source branches refreshed into writable Forgejo main (independent of
# BOOTSTRAP_BRANCH). Empty uses seed.json source_branch, falling back to main.
# A nonempty inherited shell value takes precedence over this file.
ANSIBLE_COLLECTION_TEMPLATE_BRANCH=''
ANSIBLE_COLLECTION_DEMO_WEBAPP_BRANCH=''
DEMOJAM_ANSIBLE_BRANCH=''
# Optional public GitOps source (default: origin) and AAP/monitoring storage class
# (default: discover the cluster's default StorageClass).
BOOTSTRAP_REPO_URL=''
BOOTSTRAP_STORAGE_CLASS=''
# Optional JSON users file; default bootstrap/users.example.json generates
# demo-user. DEMO_USER_PASSWORD supplies the initial password for new users.
# Copy the example to a local file and set this path to supply your users.
DEMO_USERS_FILE=''
# Shared initial user password; undefined/empty defaults to changeme.
# Reruns preserve passwords for existing accounts.
DEMO_USER_PASSWORD='changeme'

# Shared defaults; existing configurations still apply these to both consumers.
# Select opencode-go or litellm. Each consumer uses its selected provider inputs.
MODEL_PROVIDER='litellm'
OPENCODE_GO_ENDPOINT='https://opencode.ai/zen/go/v1'
OPENCODE_GO_MODEL='gpt-6-luna'
# Select responses for GPT models, chat for Chat Completions models (e.g. Kimi),
# or anthropic for Claude (e.g. OPENCODE_GO_MODEL='claude-haiku-5-5').
# These defaults can be overridden independently for AO and Omnigent below.
OPENCODE_GO_PROTOCOL='responses'
OPENCODE_GO_API_KEY=''
LITELLM_ENDPOINT=''
LITELLM_MODEL='qwen38-27b'
LITELLM_API_KEY=''
# Qwen3.8 only: none disables thinking; low, medium, or xhigh enables it.
# Shared fallback for consumers selecting qwen38-27b through LiteLLM.
QWEN_REASONING_EFFORT='none'

# Independent consumers. Empty values inherit the selected provider's defaults.
# Example: Qwen decisions/RCA in AO, Go Haiku coding in Omnigent:
# AO_MODEL_PROVIDER='litellm'
# AO_MODEL='qwen38-27b'
# AO_QWEN_REASONING_EFFORT='low'
# OMNIGENT_MODEL_PROVIDER='opencode-go'
# OMNIGENT_MODEL='claude-haiku-5-5'
# OMNIGENT_MODEL_PROTOCOL='anthropic'
AO_MODEL_PROVIDER=''
AO_MODEL=''
AO_MODEL_ENDPOINT=''
AO_MODEL_API_KEY=''
AO_MODEL_PROTOCOL=''
AO_QWEN_REASONING_EFFORT=''
OMNIGENT_MODEL_PROVIDER=''
OMNIGENT_MODEL=''
OMNIGENT_MODEL_ENDPOINT=''
OMNIGENT_MODEL_API_KEY=''
OMNIGENT_MODEL_PROTOCOL=''
OMNIGENT_QWEN_REASONING_EFFORT=''
# Optional endpoint/key overrides allow separate accounts on the same provider.
# LiteLLM uses chat; OpenCode Go supports responses, chat and anthropic.

# AO's timeout around each full LLM attempt, including structured output.
# The application default is 30 seconds; bootstrap uses 90 unless overridden.
AO_LLM_REQUEST_TIMEOUT_SECONDS='90'

# Subscription ZIP also supplies this demo's RHEL CDN entitlement.
AAP_LICENSE_FILE='aap_manifest.zip'
# Optional AAP overrides. Bootstrap normally discovers the URL and uses the
# operator-generated admin credential; never paste generated passwords here.
AAP_HOST=''
AAP_USERNAME='admin'
AAP_PASSWORD=''
# Uses the pinned Red Hat ee-supported-rhel9 image; no custom EE or Hub token.
# AAP_EE_IMAGE=''

# Optional Forgejo overrides for direct tooling. AAP reads public demo repos.
FORGEJO_URL=''
FORGEJO_TOKEN=''

# Runtime credentials are generated/reused by bootstrap in Kubernetes:
# model Secrets, Forgejo/Backstage tokens, AAP admin, VM API token, VM SSH key,
# and the RHEL entitlement extracted from the manifest. No registry login needed.

# AWS/CNV target backend. Root/admin credentials are used only by local bootstrap.
# Empty backend defaults to CNV on a fresh installation.
DEMO_BACKEND=''

# Native read-only MCP diagnostics for AO RCA: defaults on for CNV, off for AWS.
# AWS MCP transport is not supported yet. false keeps the audit-only workflow.
WEBAPP_MCP_ENABLED=''
AWS_BOOTSTRAP_ACCESS_KEY_ID=''
AWS_BOOTSTRAP_SECRET_ACCESS_KEY=''
AWS_DEMO_ACCOUNT_ID=''
AWS_DEMO_REGION='us-east-2'
AWS_DEMO_AZ=''
AWS_DEMO_VPC_CIDR='10.77.0.0/24'
AWS_DEMO_SSH_CIDR='0.0.0.0/0'
AWS_DEMO_HTTP_CIDR='0.0.0.0/0'
AWS_WEBAPP_INSTANCE_TYPE='t3.medium'
AWS_MOLECULE_INSTANCE_TYPE='t3.medium'
AWS_DEMO_ROOT_VOLUME_SIZE_GIB='30'
AWS_RHEL9_AMI_ID=''
AWS_RHEL10_AMI_ID=''

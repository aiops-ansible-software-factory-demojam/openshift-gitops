# Copy to .env (gitignored), chmod 600 .env, and fill the required inputs below.
# All bootstrap/demo entry points load this trusted Bash configuration.
# For the AWS Lightwell demo, start with .env.invoice.example instead.

# =============================================================================
# REQUIRED INPUTS: subscription and scenario/provider selection
# =============================================================================
# A real AAP subscription manifest ZIP. CNV also uses its RHEL entitlement.
# AWS guests use RHUI, but AAP still requires the subscription manifest.
AAP_LICENSE_FILE='aap_manifest.zip'
# Backend: empty defaults to CNV on a fresh installation; aws selects EC2.
DEMO_BACKEND=''
# Scenarios: selinux deploys nginx; both (or invoice) also deploys Python on a separate AWS RHEL host.
DEMO_SCENARIO='selinux'
# Provider: litellm, openshift-ai, or opencode-go. Fill only its inputs below.
# AO and Omnigent share this provider unless consumer overrides are supplied.
MODEL_PROVIDER='litellm'

# REQUIRED WHEN MODEL_PROVIDER=litellm (the default).
# Use an HTTPS API base URL, not a /chat/completions endpoint.
LITELLM_ENDPOINT=''
LITELLM_MODEL='qwen38-27b'
LITELLM_API_KEY=''

# REQUIRED WHEN MODEL_PROVIDER=openshift-ai.
# Use the authenticated HTTPS API base URL, model name, and API key.
OPENSHIFT_AI_ENDPOINT=''
OPENSHIFT_AI_MODEL=''
OPENSHIFT_AI_API_KEY=''

# REQUIRED WHEN MODEL_PROVIDER=opencode-go.
# Endpoint, model, and protocol have defaults in the optional section.
OPENCODE_GO_API_KEY=''

# REQUIRED WHEN DEMO_BACKEND=aws.
# Local bootstrap uses this provisioning identity to create scoped runtime keys.
AWS_BOOTSTRAP_ACCESS_KEY_ID=''
AWS_BOOTSTRAP_SECRET_ACCESS_KEY=''

# REQUIRED WHEN DEMO_SCENARIO=invoice or both (also set DEMO_BACKEND=aws).
# Ansible discovers the patched wheel from Lightwell. Optional descriptor pins
# an approved selection; leave empty for one unambiguous compatible fix.
# See docs/invoice-lightwell-demo.md. Signing trust is independently required.
INVOICE_LIGHTWELL_ARTIFACT_FILE=''
# Full Lightwell service-account username, including its prefix and | separator.
INVOICE_LIGHTWELL_USERNAME=''
# Service-account token (the password in the repository connection instructions).
INVOICE_LIGHTWELL_TOKEN=''
INVOICE_SIGNING_KEY_FILE=''
INVOICE_SIGNING_KEY_SHA256=''

# =============================================================================
# OPTIONAL OVERRIDES: leave these defaults unless you need to change them
# =============================================================================

# Cluster access: the active oc login is used by default.
# A nonempty inherited KUBECONFIG takes precedence over this file.
# KUBECONFIG="$HOME/.kube/config"

# GitOps uses origin/main and seed.json source refs by default. Select feature
# refs for unmerged invoice content; .env.invoice.example supplies those refs.
# Storage class defaults to the cluster default.
BOOTSTRAP_BRANCH=''
BOOTSTRAP_REPO_URL=''
BOOTSTRAP_STORAGE_CLASS=''
# Optional committed sibling checkouts used as sources during local development.
DEMO_LOCAL_SOURCES=''
# Historical *_BRANCH names accept branches or release tags. Empty uses
# seed.json source_branch, falling back to main. Inherited values take precedence.
# See .env.demo.example for the release-pinned original demo configuration.
ANSIBLE_COLLECTION_TEMPLATE_BRANCH=''
ANSIBLE_COLLECTION_DEMO_WEBAPP_BRANCH=''
ANSIBLE_COLLECTION_DEMO_PYTHONAPP_BRANCH=''
DEMOJAM_ANSIBLE_BRANCH=''

# User setup: bootstrap/users.example.json creates demo-user by default.
# Reruns preserve existing passwords; empty password defaults to changeme.
DEMO_USERS_FILE=''
DEMO_USER_PASSWORD='changeme'

# OpenCode Go defaults, used only when that provider is selected.
OPENCODE_GO_ENDPOINT='https://opencode.ai/zen/go/v1'
OPENCODE_GO_MODEL='gpt-6-luna'
# responses for GPT, chat for Chat Completions, anthropic for Claude.
OPENCODE_GO_PROTOCOL='responses'
# Qwen3.8 effort: none disables thinking; low, medium, or xhigh enables it.
QWEN_REASONING_EFFORT='none'

# Independent consumers: empty values inherit the selected provider.
# Example: Qwen decisions/RCA in AO, Go Haiku coding in Omnigent:
# AO_MODEL_PROVIDER='litellm'
# AO_MODEL='qwen38-27b'
# OMNIGENT_MODEL_PROVIDER='opencode-go'
# OMNIGENT_MODEL='claude-haiku-5-5'
# OMNIGENT_MODEL_PROTOCOL='anthropic'
# LiteLLM and OpenShift AI default to chat. Go supports all three protocols.
AO_MODEL_PROVIDER=''
AO_MODEL=''
AO_MODEL_ENDPOINT=''
AO_MODEL_API_KEY=''
AO_MODEL_PROTOCOL=''
AO_QWEN_REASONING_EFFORT=''
OMNIGENT_MODEL_PROVIDER=''
OMNIGENT_MODEL=''
OMNIGENT_MODEL_ENDPOINT=''
OMNIGENT_MODEL_API_KEY=''
OMNIGENT_MODEL_PROTOCOL=''
OMNIGENT_QWEN_REASONING_EFFORT=''
# AO timeout per full LLM attempt; bootstrap defaults to 90 seconds.
AO_LLM_REQUEST_TIMEOUT_SECONDS='90'

# AAP: URL and operator-generated admin credential are normally discovered.
AAP_HOST=''
AAP_USERNAME='admin'
AAP_PASSWORD=''
# Uses the pinned Red Hat ee-supported-rhel9 image by default.
# AAP_EE_IMAGE=''

# Forgejo overrides for direct tooling. AAP reads public demo repositories.
FORGEJO_URL=''
FORGEJO_TOKEN=''

# Invoice test image: empty resolves the completed sandbox build. An override
# must be an immutable image with ADT, Molecule, AWS collections, and Cosign.
INVOICE_TEST_EE_IMAGE=''

# Native read-only MCP diagnostics: defaults on for CNV, off for AWS.
# AWS opt-in restricts EC2 8443 to discovered AO public egress /32 addresses.
WEBAPP_MCP_ENABLED=''

# AWS placement, network, sizing, and image overrides. Empty account, AZ, and
# AMIs are discovered and recorded by bootstrap.
AWS_DEMO_ACCOUNT_ID=''
AWS_DEMO_REGION='us-east-2'
AWS_DEMO_AZ=''
AWS_DEMO_VPC_CIDR='10.77.0.0/24'
AWS_DEMO_SSH_CIDR='0.0.0.0/0'
AWS_DEMO_HTTP_CIDR='0.0.0.0/0'
AWS_WEBAPP_INSTANCE_TYPE='t3.medium'
AWS_PYTHONAPP_INSTANCE_TYPE='t3.medium'
AWS_MOLECULE_INSTANCE_TYPE='t3.medium'
AWS_DEMO_ROOT_VOLUME_SIZE_GIB='30'
AWS_RHEL9_AMI_ID=''
AWS_RHEL10_AMI_ID=''

# Bootstrap generates/reuses model Secrets, Forgejo/Backstage tokens, AAP admin,
# guest API/SSH credentials, and (for CNV) RHEL entitlement in Kubernetes.
# No registry login or generated passwords need to be filled here.

# Optional operator-approved application/advisory profile and baseline descriptor.
# Empty selects demo/invoice/profile.json and demo/invoice/baseline.json.
REMEDIATION_PROFILE_FILE=''
REMEDIATION_BASELINE_FILE=''

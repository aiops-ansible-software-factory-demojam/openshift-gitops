# Local secrets and configuration. Copy to .env and keep values out of Git.
# Bash-compatible: quote values; single quotes keep $, spaces, and # literal.
# Load from the repo root: set -a; source .env; set +a

# Demo cluster access: path only, never paste kubeconfig contents here.
KUBECONFIG=''
EXPECTED_SERVER=''
FORGEJO_URL=''

# Bootstrap / demo-reset: your OpenCode Go subscription key.
MODEL_API_KEY=''
# Leave model overrides unset to use the scripts' OpenCode Go / gpt-6-luna defaults.
# MODEL_BASE_URL='https://opencode.ai/zen/go/v1'
# MODEL_NAME='gpt-6-luna'

# AAP config-as-code: gateway URL, generated admin password, and published EE.
AAP_HOST=''
AAP_USERNAME='admin'
AAP_PASSWORD=''
AAP_EE_IMAGE=''

# AAP SCM / direct Forgejo API calls.
# For AAP use the hydration-generated demo-agent token from:
# cluster/forgejo-demo/.state/<ingress-domain>/agent-token
# Admin-only Forgejo API calls require the admin-token instead.
FORGEJO_TOKEN=''

# VM deployer: mint from aap-vm-deployer in automation-vms after deploying the PR.
# Tokens expire; renew this value and reapply AAP configuration when needed.
K8S_AUTH_HOST=''
K8S_AUTH_API_KEY=''
# Public CA certificate CONTENTS for the AAP credential; multiline quotes work.
AAP_K8S_CA_CERT=''
# Local navigator VM runs: absolute path to the public CA certificate FILE.
# Do not set K8S_AUTH_CA_CERT to certificate contents.
K8S_AUTH_SSL_CA_CERT=''

# EE base image: these variables are used by the documented podman login command.
REDHAT_REGISTRY_USERNAME=''
REDHAT_REGISTRY_PASSWORD=''
# Optional external EE registry; internal cluster pulls use service account auth.
EE_REGISTRY_HOST=''
EE_REGISTRY_USERNAME=''
EE_REGISTRY_PASSWORD=''

# Optional direct Forgejo webhook configuration; AO's normal workflow omits it.
WEBHOOK_SECRET=''

# AAP subscription manifest: reference its file, not its ZIP contents.
# This is a local reference for upload; make configure does not install a license.
# Keep a manifest stored inside this repo under the gitignored .secrets/ directory.
AAP_LICENSE_FILE=''

# Bootstrap/operators generate database, AO/Omnigent machine, and app credentials.
# Hydration generates Forgejo/Backstage tokens. Those flows continue managing
# their Kubernetes Secrets and local .state files; this file is not auto-loaded.

# Copy to .env (gitignored), chmod 600 .env, and populate operator-owned inputs.
# All bootstrap/demo entry points load this file automatically.
# Export KUBECONFIG in your shell, or uncomment an explicit path here.
# A nonempty inherited KUBECONFIG takes precedence over this file.
# KUBECONFIG="$HOME/.kube/config"
BOOTSTRAP_BRANCH=''
# Optional public GitOps source (default: origin) and AAP/monitoring storage class
# (default: discover the cluster's default StorageClass).
BOOTSTRAP_REPO_URL=''
BOOTSTRAP_STORAGE_CLASS=''
# Optional JSON users file; default bootstrap/users.example.json generates
# demo-user. DEMO_USER_PASSWORD supplies the initial password for new users.
# Copy the example to a local file and set this path to supply your users.
DEMO_USERS_FILE=''
# Shared initial user password; undefined/empty defaults to changeme.
# Reruns preserve passwords for existing accounts.
DEMO_USER_PASSWORD='changeme'

# Select opencode-go or litellm. Only the selected provider's inputs are used.
MODEL_PROVIDER='opencode-go'
OPENCODE_GO_ENDPOINT='https://opencode.ai/zen/go/v1'
OPENCODE_GO_MODEL='gpt-6-luna'
OPENCODE_GO_API_KEY=''
LITELLM_ENDPOINT=''
LITELLM_MODEL='gpt-oss-120b'
LITELLM_API_KEY=''

# Subscription ZIP also supplies this demo's RHEL CDN entitlement.
AAP_LICENSE_FILE='aap_manifest.zip'
# Optional AAP overrides. Bootstrap normally discovers the URL and uses the
# operator-generated admin credential; never paste generated passwords here.
AAP_HOST=''
AAP_USERNAME='admin'
AAP_PASSWORD=''
# Uses the pinned Red Hat ee-supported-rhel9 image; no custom EE or Hub token.
# AAP_EE_IMAGE=''

# Optional Forgejo overrides for direct tooling. AAP reads public demo repos.
FORGEJO_URL=''
FORGEJO_TOKEN=''

# Runtime credentials are generated/reused by bootstrap in Kubernetes:
# model Secrets, Forgejo/Backstage tokens, AAP admin, VM API token, VM SSH key,
# and the RHEL entitlement extracted from the manifest. No registry login needed.

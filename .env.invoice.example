# AWS Lightwell invoice demo. Copy to the ignored .env and chmod 600 .env.
# When updating an existing .env, merge settings to preserve its credentials.

# =============================================================================
# REQUIRED INPUTS: fill these before the complete rehearsal
# =============================================================================
# Keep these selections for EC2 guests and OpenShift AI inference.
DEMO_BACKEND='aws'
DEMO_SCENARIO='invoice'
MODEL_PROVIDER='openshift-ai'

# Authorized AWS provisioning identity; bootstrap creates scoped runtime keys.
AWS_BOOTSTRAP_ACCESS_KEY_ID=''
AWS_BOOTSTRAP_SECRET_ACCESS_KEY=''
# Real AAP subscription manifest ZIP (repository-relative or absolute path).
AAP_LICENSE_FILE='aap_manifest.zip'

# Shared by AO and Omnigent. HTTPS API base URL, not /chat/completions.
OPENSHIFT_AI_ENDPOINT=''
OPENSHIFT_AI_MODEL=''
OPENSHIFT_AI_API_KEY=''

# Actual Lightwell wheel/provenance descriptor and repository-read credentials.
# Descriptor format: docs/invoice-lightwell-demo.md, Required operator inputs.
INVOICE_LIGHTWELL_ARTIFACT_FILE=''
# Full service-account username, including its prefix and | separator.
INVOICE_LIGHTWELL_USERNAME=''
# Service-account token (the password shown in the connection instructions).
INVOICE_LIGHTWELL_TOKEN=''
# Trusted public signing key PEM and its independently verified file SHA256.
INVOICE_SIGNING_KEY_FILE=''
INVOICE_SIGNING_KEY_SHA256=''

# =============================================================================
# OPTIONAL OVERRIDES: defaults are sufficient for this demo configuration
# =============================================================================
AWS_DEMO_REGION='us-east-2'
# Empty resolves the successfully built sandbox execution image.
INVOICE_TEST_EE_IMAGE=''

# Current development source selections, already set for the unmerged invoice
# implementation. Keep these until the companion PRs are merged, or select
# another revision containing the invoice content.
ANSIBLE_COLLECTION_DEMO_WEBAPP_BRANCH='feature/lightwell-invoice-demo'
DEMOJAM_ANSIBLE_BRANCH='feature/lightwell-invoice-demo'
# Use committed sibling checkouts instead of GitHub refs when developing locally.
DEMO_LOCAL_SOURCES=''
# Empty uses origin/main. invoice-publish prints the cluster-local GitOps URL
# and branch to use when publishing the implementation into Forgejo.
BOOTSTRAP_REPO_URL=''
BOOTSTRAP_BRANCH=''

# Additional optional overrides, including per-consumer model configuration,
# AWS sizing/networking, and user setup, are documented in .env.example.

# Optional operator-approved application/advisory profile and baseline descriptor.
# Empty selects demo/invoice/profile.json and demo/invoice/baseline.json.
REMEDIATION_PROFILE_FILE=''
REMEDIATION_BASELINE_FILE=''

# AWS + native MCP demo run on 2026-10-16. Only this run's settings are included.
# Copy to .env, chmod 600 .env, and fill the three blank credential values.
# See docs/native-mcp-demo-2026-10-16.md for the commands and tested revisions.
KUBECONFIG="$HOME/.kube/config"
BOOTSTRAP_BRANCH='feature/rhel-mcp-rca'
ANSIBLE_COLLECTION_TEMPLATE_BRANCH='main'
ANSIBLE_COLLECTION_DEMO_WEBAPP_BRANCH='main'
DEMOJAM_ANSIBLE_BRANCH='feature/rhel-mcp-rca'

DEMO_BACKEND='aws'
WEBAPP_MCP_ENABLED='true'
AWS_BOOTSTRAP_ACCESS_KEY_ID=''
AWS_BOOTSTRAP_SECRET_ACCESS_KEY=''
AWS_DEMO_REGION='us-east-2'
AWS_DEMO_VPC_CIDR='10.77.0.0/24'
AWS_DEMO_SSH_CIDR='0.0.0.0/0'
AWS_DEMO_HTTP_CIDR='0.0.0.0/0'
AWS_WEBAPP_INSTANCE_TYPE='t3.medium'
AWS_MOLECULE_INSTANCE_TYPE='t3.medium'
AWS_DEMO_ROOT_VOLUME_SIZE_GIB='30'

LITELLM_ENDPOINT='https://maas-rhdp.apps.maas.redhatworkshops.io/v1'
LITELLM_API_KEY=''
AO_MODEL_PROVIDER='litellm'
AO_MODEL='qwen38-27b'
AO_MODEL_PROTOCOL='chat'
AO_QWEN_REASONING_EFFORT='none'
OMNIGENT_MODEL_PROVIDER='litellm'
OMNIGENT_MODEL='qwen38-27b'
OMNIGENT_MODEL_PROTOCOL='chat'
OMNIGENT_QWEN_REASONING_EFFORT='none'
AO_LLM_REQUEST_TIMEOUT_SECONDS='90'

# Existing operator-owned ZIP in the repository root; it is not committed.
AAP_LICENSE_FILE='aap_manifest.zip'
# Initial password for the default demo-user; reruns preserve existing passwords.
DEMO_USER_PASSWORD='changeme'

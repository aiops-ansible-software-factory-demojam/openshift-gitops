  <diagram id="cve-routing" name="04 CVE responses">
    <mxGraphModel dx="1960" dy="1280" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1280" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="accent" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#C52932;strokeColor=#C52932;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="46" width="7" height="72" />
        </mxCell>
        <mxCell id="eyebrow" value="DEMO WALKTHROUGH" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;spacing=0;fontFamily=Arial;fontSize=13;fontColor=#B73138;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="75" y="38" width="1800" height="22" />
        </mxCell>
        <mxCell id="title" value="CVE response routing — four governed outcomes" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;spacing=0;fontFamily=Arial;fontSize=37;fontColor=#172B40;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="75" y="68" width="1800" height="54" />
        </mxCell>
        <mxCell id="subtitle" value="Same detection trigger and coding agent • operator policy in vars • no SBOM platform required" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#536579;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="75" y="128" width="1800" height="35" />
        </mxCell>
        <mxCell id="observations" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#176B9B;line-height:1.3&quot;&gt;TRUSTED AAP&lt;/div&gt;&lt;div style=&quot;font-size:24px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Observe and discover&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;Read actual dependency versions and business state. Discover Lightwell fixes. Pass real assessment and discovery job IDs.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F7FC;strokeColor=#176B9B;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="280" y="220" width="590" height="170" />
        </mxCell>
        <mxCell id="router" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#176B9B;line-height:1.3&quot;&gt;TRUSTED ANSIBLE POLICY&lt;/div&gt;&lt;div style=&quot;font-size:24px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Choose one response&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;Verify job provenance, profile and complete host evidence. Use approved fix identity, CVSS scores and configured containment policy.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F7FC;strokeColor=#176B9B;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1090" y="220" width="590" height="170" />
        </mxCell>
        <mxCell id="patch" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#24714E;line-height:1.3&quot;&gt;CVE RESPONSE&lt;/div&gt;&lt;div style=&quot;font-size:22px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Reviewed application fix&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;Known affected dependency + confirmed approved Lightwell artifact.&lt;br&gt;Existing coding agent → PR → independent acceptance → human merge → production approval → verified deployment.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF7EF;strokeColor=#24714E;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="610" width="380" height="330" />
        </mxCell>
        <mxCell id="contain" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#A76B00;line-height:1.3&quot;&gt;CVE RESPONSE&lt;/div&gt;&lt;div style=&quot;font-size:22px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Temporary containment&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;All scoped hosts affected; high severity; no approved fix.&lt;br&gt;Open security review → human approval → trusted recheck → stop and disable only the scoped application service. Not a CVE fix.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF5DC;strokeColor=#A76B00;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="610" width="380" height="330" />
        </mxCell>
        <mxCell id="defer" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#64748B;line-height:1.3&quot;&gt;CVE RESPONSE&lt;/div&gt;&lt;div style=&quot;font-size:22px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Defer and review&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;Known lower-severity no-fix finding.&lt;br&gt;Keep an open security ticket with an anchored review deadline. No host changes. Fixed, healthy observations reconcile incidents.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#64748B;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1030" y="610" width="380" height="330" />
        </mxCell>
        <mxCell id="manual" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#B73138;line-height:1.3&quot;&gt;CVE RESPONSE&lt;/div&gt;&lt;div style=&quot;font-size:22px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Manual security review&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;Unknown version or severity, unsupported ecosystem/control, or mixed containment scope.&lt;br&gt;Retain the finding and review ticket. No automatic host mutation or coding session.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF0F0;strokeColor=#B73138;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1510" y="610" width="380" height="330" />
        </mxCell>
        <mxCell id="failure" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#64748B;line-height:1.3&quot;&gt;OPERATING RULE&lt;/div&gt;&lt;div style=&quot;font-size:23px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Failures remain failures; containment remains unresolved&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;API or discovery errors stop the run. Approval denial/timeout blocks containment. Verify service state after shutdown. Restore service through a reviewed fixed release; require healthy business checks before closing either incident type.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#64748B;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1000" width="1820" height="150" />
        </mxCell>
        <mxCell id="footer-line" value="" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D9E2EC;strokeColor=#D9E2EC;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1214" width="1860" height="1" />
        </mxCell>
        <mxCell id="footer-caption" value="Policy is explicit operator data. The real invoice advisory score remains 6.2; high-severity containment tests use synthetic findings." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;spacing=0;fontFamily=Arial;fontSize=13;fontColor=#536579;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1230" width="1550" height="27" />
        </mxCell>
        <mxCell id="footer-page" value="04 / 04" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#536579;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1750" y="1230" width="160" height="27" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#71859A;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=1;entryPerimeter=1;fontFamily=Arial;fontSize=12;fontColor=#71859A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="observations" target="router">

        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="nginx / SELinux | alert to reviewed recovery" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=32;fontColor=#192E43;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="35" width="1980" height="55" />
        </mxCell>
        <mxCell id="subtitle" value="AO workflow: Check Audit logs, Determine RCA, Create Issue → omnigent-remediation. The operator owns independent testing, merge and recovery." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=17;fontColor=#526578;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="100" width="1980" height="58" />
        </mxCell>
        <mxCell id="footer" value="AIOps Ansible Software Factory | Current implementation: 2026-10-28 | AWS dual-app paths verified; CNV and alternative mitigation are separately qualified." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=12;fontColor=#526578;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1275" width="1980" height="24" />
        </mxCell>
        <mxCell id="fault" value="1  AAP fault job&#10;webapp_selinux_enable&#10;webapps → Enforcing, backend HTTP 403" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="220" width="400" height="140" />
        </mxCell>
        <mxCell id="alert" value="2  Availability alert&#10;Blackbox probe fails for one minute&#10;Alertmanager → authenticated EDA" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="560" y="220" width="400" height="140" />
        </mxCell>
        <mxCell id="rca" value="3  AO root cause&#10;Optional read-only native MCP&#10;Otherwise AAP audit facts + text RCA" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1040" y="220" width="400" height="140" />
        </mxCell>
        <mxCell id="issue" value="4  Forgejo incident&#10;webapp_alert_issue opens/reuses issue&#10;Outage marker + completed RCA" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1520" y="220" width="400" height="140" />
        </mxCell>
        <mxCell id="test" value="8  Operator independent validation&#10;Exact published SHA; isolated source export&#10;Build / install / lint / units / full RHEL 9+10" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFF3D6;strokeColor=#BC8B24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="510" width="400" height="140" />
        </mxCell>
        <mxCell id="pr" value="7  Guarded candidate publication&#10;Reject caches / escaping links&#10;Open PR; never merge or deploy" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="560" y="510" width="400" height="140" />
        </mxCell>
        <mxCell id="author" value="6  Agent implements / tests&#10;Preserve Enforcing; regression assertions&#10;Fresh guests after final changes" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1040" y="510" width="400" height="140" />
        </mxCell>
        <mxCell id="handoff" value="5  Issue webhook → EDA → AO&#10;New valid incident only&#10;Developer Hub branch → coding session" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1520" y="510" width="400" height="140" />
        </mxCell>
        <mxCell id="merge" value="9  Human review / merge&#10;All checks pass; same head and base&#10;Merge guard binds tested SHA" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFF3D6;strokeColor=#BC8B24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="800" width="400" height="140" />
        </mxCell>
        <mxCell id="deploy" value="10  One AAP recovery launch&#10;webapp_nginx via existing wrapper&#10;Refresh source/inventory, preserve Enforcing" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="560" y="800" width="400" height="140" />
        </mxCell>
        <mxCell id="verify" value="11  Verify actual recovery&#10;verify-enforcing; internal probe&#10;Enforcing + HTTP 200 + probe success" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E9F5EC;strokeColor=#43885B;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1040" y="800" width="400" height="140" />
        </mxCell>
        <mxCell id="resolved" value="12  Prove normal resolution&#10;No active WebappDown alert&#10;Record tests, merge and deployment evidence" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E9F5EC;strokeColor=#43885B;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1520" y="800" width="400" height="140" />
        </mxCell>

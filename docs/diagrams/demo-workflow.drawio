  <diagram id="python-patch" name="04 Python patch">
    <mxGraphModel dx="2100" dy="1320" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1320" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Python / Lightwell | validated commit to approved deployment" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=32;fontColor=#192E43;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="35" width="1980" height="55" />
        </mxCell>
        <mxCell id="subtitle" value="AO: invoice-security-detect → Forgejo/EDA → invoice-security-remediation. Production targets only pythonapps; its SELinux mode remains Enforcing." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=17;fontColor=#526578;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="100" width="1980" height="58" />
        </mxCell>
        <mxCell id="footer" value="AIOps Ansible Software Factory | Current implementation: 2026-10-28 | AWS dual-app paths verified; CNV and alternative mitigation are separately qualified." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=12;fontColor=#526578;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1275" width="1980" height="24" />
        </mxCell>
        <mxCell id="detect" value="1  Explicit detection&#10;invoice_check observes installed dependency&#10;Normal/regression business evidence" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="205" width="400" height="150" />
        </mxCell>
        <mxCell id="discover" value="2  Ansible Lightwell discovery&#10;Pinned OSV + authenticated JSON index&#10;Match CVEs / runtime / wheel / digest" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F1EBFA;strokeColor=#8664AA;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="560" y="205" width="400" height="150" />
        </mxCell>
        <mxCell id="router" value="3  Trusted CVE route&#10;invoice_route reads actual AAP receipts&#10;Approved compatible fix → app_patch" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1040" y="205" width="400" height="150" />
        </mxCell>
        <mxCell id="issue" value="4  Incident → EDA handoff&#10;Deduplicated Python issue / fixed marker&#10;Only newly opened incidents start authoring" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1520" y="205" width="400" height="150" />
        </mxCell>
        <mxCell id="trusted" value="8  Independent trusted acceptance&#10;invoice_validate + separate mandatory suite&#10;RHEL 9/10, provenance, regression, rollback" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E9F5EC;strokeColor=#43885B;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="470" width="400" height="150" />
        </mxCell>
        <mxCell id="candidate" value="7  AO observes published PR&#10;Fixed branch / repo / base, exact head&#10;Publish pending required validation status" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="560" y="470" width="400" height="150" />
        </mxCell>
        <mxCell id="agent" value="6  Agent tests and publishes&#10;Update approved release lock&#10;Needed code/tests only; guarded PR" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1040" y="470" width="400" height="150" />
        </mxCell>
        <mxCell id="branch" value="5  Developer Hub + Omnigent&#10;Prepare feature/issue-N, claim incident&#10;One shared coding session; model configurable" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1520" y="470" width="400" height="150" />
        </mxCell>
        <mxCell id="merge" value="9  Required check + human merge&#10;Publish success only from trusted evidence&#10;Changed head / failed CI stops flow" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFF3D6;strokeColor=#BC8B24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="735" width="400" height="150" />
        </mxCell>
        <mxCell id="contract" value="10  Prepare immutable contract&#10;invoice_prepare_release binds tested source&#10;Wheel, profile, material, image, validation" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="560" y="735" width="400" height="150" />
        </mxCell>
        <mxCell id="promote" value="11  Reuse invoice_promote&#10;validate-release → HUMAN APPROVAL&#10;recheck-release → invoice_deploy" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFF3D6;strokeColor=#BC8B24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1040" y="735" width="400" height="150" />
        </mxCell>
        <mxCell id="proof" value="12  Prove deployment / close&#10;Verify actual approval, job, source and wheel&#10;Business/regression checks → close incident" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E9F5EC;strokeColor=#43885B;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1520" y="735" width="400" height="150" />
        </mxCell>

        <mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=24;html=0;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#526B83;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="discover" target="router">

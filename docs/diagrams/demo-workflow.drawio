        <mxCell id="edge-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=24;html=0;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#526B83;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="promote" target="proof">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="failure" value="FAIL CLOSED&#10;Failed acceptance, changed source/material, rejection or timeout prevents deployment. No automatic re-authoring loop. A failed rollout remains failed even if rollback restores service." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FCEBEB;strokeColor=#BB5353;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="1000" width="920" height="100" />
        </mxCell>
        <mxCell id="reuse" value="RESOURCE REUSE&#10;Configure JTs/workflow once. Each launch passes a new immutable contract and full SCM SHA. No per-release project, credential, JT or workflow is generated." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F1F4F7;strokeColor=#91A0AE;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1040" y="1000" width="880" height="100" />
        </mxCell>

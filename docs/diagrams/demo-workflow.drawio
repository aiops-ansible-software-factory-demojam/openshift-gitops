        <mxCell id="nginx-note" value="Failure at candidate validation: leave the PR unmerged and the attempt failed. Do not repair the agent branch or make SELinux permissive to claim recovery. A merge-linked issue closure is not health evidence. No native nginx approval workflow, Actions runner, or automatic CI-repair controller is deployed." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F1F4F7;strokeColor=#91A0AE;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">

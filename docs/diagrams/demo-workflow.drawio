  <diagram id="nginx" name="03 Nginx SELinux">
    <mxGraphModel dx="1960" dy="1280" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1280" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="accent" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#C52932;strokeColor=#C52932;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="46" width="7" height="72" />
        </mxCell>
        <mxCell id="eyebrow" value="DEMO WALKTHROUGH" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;spacing=0;fontFamily=Arial;fontSize=13;fontColor=#B73138;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="75" y="38" width="1800" height="22" />
        </mxCell>
        <mxCell id="title" value="Nginx SELinux outage — diagnosed and reviewed recovery" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;spacing=0;fontFamily=Arial;fontSize=37;fontColor=#172B40;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="75" y="68" width="1800" height="54" />
        </mxCell>
        <mxCell id="subtitle" value="A separate RHEL host • real audit evidence • persistent file labels • independent operator validation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#536579;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="75" y="128" width="1800" height="35" />
        </mxCell>
        <mxCell id="row1-label" value="INCIDENT → AUTHORING" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#176B9B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="188" width="1800" height="28" />
        </mxCell>
        <mxCell id="row2-label" value="EVIDENCE → REVIEWED RECOVERY" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#176B9B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="620" width="1800" height="28" />
        </mxCell>
        <mxCell id="n1" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#A76B00;line-height:1.3&quot;&gt;01  OPERATOR / AAP&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Introduce the outage&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;Run webapp_selinux_enable on webapps only.&lt;br&gt;Switch the web host to Enforcing.&lt;br&gt;The Python host is unaffected.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF5DC;strokeColor=#A76B00;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="235" width="270" height="255" />
        </mxCell>
        <mxCell id="n2" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#176B9B;line-height:1.3&quot;&gt;02  MONITORING&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Observe HTTP failure&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;The blackbox probe returns 403.&lt;br&gt;WebappDown fires after one minute.&lt;br&gt;Alertmanager delivers the alert to EDA.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F7FC;strokeColor=#176B9B;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="380" y="235" width="270" height="255" />
        </mxCell>
        <mxCell id="n3" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#176B9B;line-height:1.3&quot;&gt;03  EDA → AO&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Start investigation&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;The alert listener invokes the AO root-cause workflow.&lt;br&gt;Keep the original alert context through diagnosis.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F7FC;strokeColor=#176B9B;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="690" y="235" width="270" height="255" />
        </mxCell>
        <mxCell id="n4" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#176B9B;line-height:1.3&quot;&gt;04  AO + AAP&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Read live audit logs&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;AAP collects SELinux audit evidence from the web host.&lt;br&gt;AO uses the configured model to identify the denial and root cause.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F7FC;strokeColor=#176B9B;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1000" y="235" width="270" height="255" />
        </mxCell>
        <mxCell id="n5" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#176B9B;line-height:1.3&quot;&gt;05  AAP → FORGEJO&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Open the outage issue&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;AAP creates the remediation ticket with the alert and root-cause evidence in the web collection repository.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F7FC;strokeColor=#176B9B;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1310" y="235" width="270" height="255" />
        </mxCell>
        <mxCell id="n6" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#176B9B;line-height:1.3&quot;&gt;06  FORGEJO → EDA → AO&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Dispatch authoring&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;The new-issue webhook reaches EDA.&lt;br&gt;EDA starts omnigent-remediation in AO for this outage issue.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F7FC;strokeColor=#176B9B;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1620" y="235" width="270" height="255" />
        </mxCell>
        <mxCell id="n7" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#176B9B;line-height:1.3&quot;&gt;07  DEVELOPER HUB&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Prepare the branch&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;Validate the incident repository.&lt;br&gt;Create feature/issue-N.&lt;br&gt;AO requests the Omnigent authoring session.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F7FC;strokeColor=#176B9B;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="670" width="270" height="255" />
        </mxCell>
        <mxCell id="n8" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#176B9B;line-height:1.3&quot;&gt;08  AGENT SANDBOX&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Author fix + open PR&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;Add persistent httpd_sys_content_t labels and relabel /web.&lt;br&gt;Test the Ansible change.&lt;br&gt;Publish a PR; leave SELinux Enforcing.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F7FC;strokeColor=#176B9B;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="380" y="670" width="270" height="255" />
        </mxCell>
        <mxCell id="n9" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#176B9B;line-height:1.3&quot;&gt;09  INDEPENDENT OPERATOR&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Test exact published SHA&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;Use an isolated source export in the existing sandbox.&lt;br&gt;Lint, build and full Molecule lifecycle on RHEL 9 + 10.&lt;br&gt;Verify Enforcing + HTTP; destroy guests.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F7FC;strokeColor=#176B9B;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="690" y="670" width="270" height="255" />
        </mxCell>
        <mxCell id="n10" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#A76B00;line-height:1.3&quot;&gt;10  HUMAN GATE&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Review + merge&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;Inspect the code and independent evidence.&lt;br&gt;Recheck the base and tested head.&lt;br&gt;Merge with the exact SHA guard.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF5DC;strokeColor=#A76B00;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1000" y="670" width="270" height="255" />
        </mxCell>
        <mxCell id="n11" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#A76B00;line-height:1.3&quot;&gt;11  HUMAN AAP GATE&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Approve exact recovery&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;AO observes the unchanged PR merge.&lt;br&gt;Approve webapp_promote.&lt;br&gt;Trusted recheck → deploy the exact SHA to webapps.&lt;br&gt;No extra baseline recovery job.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF5DC;strokeColor=#A76B00;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1310" y="670" width="270" height="255" />
        </mxCell>
        <mxCell id="n12" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#24714E;line-height:1.3&quot;&gt;12  WEB APP / MONITORING&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Prove recovery&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;Verify SELinux Enforcing.&lt;br&gt;Require HTTP 200 and the correct page.&lt;br&gt;Confirm the probe is healthy and WebappDown resolves normally.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF7EF;strokeColor=#24714E;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1620" y="670" width="270" height="255" />
        </mxCell>
        <mxCell id="wrap-label" value="Continue to the tested release below" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#536579;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="720" y="540" width="500" height="31" />
        </mxCell>
        <mxCell id="stop" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#B73138;line-height:1.3&quot;&gt;FAIL CLOSED — KEEP THE EVIDENCE&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;A failed candidate check leaves the PR open. A failed recovery is recorded as failed. Preserve the evidence and keep the agent branch untouched.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF0F0;strokeColor=#B73138;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1010" width="1820" height="78" />
        </mxCell>
        <mxCell id="show" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#64748B;line-height:1.3&quot;&gt;SHOW DURING THE WALKTHROUGH&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;Web app and firing alert → AO audit-log diagnosis → Forgejo issue → agent / PR → independent RHEL tests → human merge → AAP recovery → healthy probe.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#64748B;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1110" width="1820" height="78" />
        </mxCell>
        <mxCell id="footer-line" value="" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D9E2EC;strokeColor=#D9E2EC;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1214" width="1860" height="1" />
        </mxCell>
        <mxCell id="footer-caption" value="The operator independently tests and launches recovery on this path. Both application and test guests are EC2; OpenShift hosts the management plane." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;spacing=0;fontFamily=Arial;fontSize=13;fontColor=#536579;fontStyle=0;" vertex="1" parent="1">

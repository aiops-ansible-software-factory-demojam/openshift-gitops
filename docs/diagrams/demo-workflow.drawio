        </mxCell>
        <mxCell id="row2-label" value="EVIDENCE → REVIEWED RECOVERY" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#176B9B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="620" width="1800" height="28" />
        </mxCell>
        <mxCell id="n1" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#A76B00;line-height:1.3&quot;&gt;01  OPERATOR / AO&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Trigger detection&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;Start invoice-security-detect.&lt;br&gt;Show the healthy normal invoice and the regression timeout on the baseline.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF5DC;strokeColor=#A76B00;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="235" width="270" height="255" />
        </mxCell>
        <mxCell id="n2" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#176B9B;line-height:1.3&quot;&gt;02  AAP + LIGHTWELL&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Assess + route the CVE&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;Read dependency + business evidence.&lt;br&gt;Find approved Lightwell fixes.&lt;br&gt;Fix path continues below; no-fix alternatives are on page 04.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F7FC;strokeColor=#176B9B;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="380" y="235" width="270" height="255" />
        </mxCell>
        <mxCell id="n3" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#176B9B;line-height:1.3&quot;&gt;03  FORGEJO → EDA&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Open the incident&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;AAP creates a deduplicated ticket.&lt;br&gt;The new-issue webhook reaches EDA and starts invoice-security-remediation in AO.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F7FC;strokeColor=#176B9B;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="690" y="235" width="270" height="255" />
        </mxCell>
        <mxCell id="n4" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#176B9B;line-height:1.3&quot;&gt;04  AO + DEVELOPER HUB&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Prepare contribution&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;Validate the repository and issue.&lt;br&gt;Create feature/issue-N.&lt;br&gt;Only a newly claimed incident starts a new authoring session.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F7FC;strokeColor=#176B9B;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1000" y="235" width="270" height="255" />
        </mxCell>
        <mxCell id="n5" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#176B9B;line-height:1.3&quot;&gt;05  AGENT SANDBOX&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Author + test the update&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;Omnigent runs the configured model.&lt;br&gt;Update the approved package lock and regression tests.&lt;br&gt;Test on disposable RHEL 9 + 10 EC2 guests.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F7FC;strokeColor=#176B9B;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1310" y="235" width="270" height="255" />
        </mxCell>
        <mxCell id="n6" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#176B9B;line-height:1.3&quot;&gt;06  FORGEJO / AO&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Publish the candidate&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;The agent opens a PR.&lt;br&gt;AO discovers its exact head SHA and publishes a pending required validation check.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F7FC;strokeColor=#176B9B;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1620" y="235" width="270" height="255" />
        </mxCell>
        <mxCell id="n7" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#176B9B;line-height:1.3&quot;&gt;07  TRUSTED AAP&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Independently validate&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;Preflight source-path contract.&lt;br&gt;Lint, build, candidate tests.&lt;br&gt;Separate trusted RHEL 9 + 10 acceptance: regression, rollback, idempotence and cleanup.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F7FC;strokeColor=#176B9B;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="670" width="270" height="255" />
        </mxCell>
        <mxCell id="n8" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#A76B00;line-height:1.3&quot;&gt;08  HUMAN GATE&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Review + merge&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;Inspect the diff and independent evidence.&lt;br&gt;Required check must pass.&lt;br&gt;Merge that exact tested SHA.&lt;br&gt;AO observes the merge.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF5DC;strokeColor=#A76B00;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="380" y="670" width="270" height="255" />
        </mxCell>
        <mxCell id="n9" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#176B9B;line-height:1.3&quot;&gt;09  AO / AAP&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Prepare release contract&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;Confirm the tested SHA is in main.&lt;br&gt;Bind source, artifact and image to a saved run of the reusable promotion workflow.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F7FC;strokeColor=#176B9B;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="690" y="670" width="270" height="255" />
        </mxCell>
        <mxCell id="n10" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#A76B00;line-height:1.3&quot;&gt;10  HUMAN AAP GATE&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Approve production&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;Approve this workflow run in AAP.&lt;br&gt;Recheck the contract before deployment.&lt;br&gt;Rejection or timeout stops the rollout.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF5DC;strokeColor=#A76B00;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1000" y="670" width="270" height="255" />
        </mxCell>
        <mxCell id="n11" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#176B9B;line-height:1.3&quot;&gt;11  AAP → RHEL HOST B&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Deploy approved release&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;Run the tested collection commit.&lt;br&gt;Verify the pinned Lightwell artifact and provenance.&lt;br&gt;Activate the immutable release on the Python host.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F7FC;strokeColor=#176B9B;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1310" y="670" width="270" height="255" />
        </mxCell>
        <mxCell id="n12" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#24714E;line-height:1.3&quot;&gt;12  AO / AAP / PORTAL&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Verify + reconcile&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;Prove approval and deployment.&lt;br&gt;Check running SHA + wheel.&lt;br&gt;Process the identical normal and regression PDFs.&lt;br&gt;Reconcile the incident.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF7EF;strokeColor=#24714E;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1620" y="670" width="270" height="255" />
        </mxCell>
        <mxCell id="wrap-label" value="Continue to the tested release below" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#536579;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="720" y="540" width="500" height="31" />
        </mxCell>
        <mxCell id="stop" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#B73138;line-height:1.3&quot;&gt;FAIL CLOSED — KEEP THE EVIDENCE&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;Failed validation blocks merge. Changed source or denied approval blocks deployment. Failed verification leaves the incident unresolved.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF0F0;strokeColor=#B73138;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1010" width="1820" height="78" />
        </mxCell>
        <mxCell id="show" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#64748B;line-height:1.3&quot;&gt;SHOW DURING THE WALKTHROUGH&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;margin-top:10px;color:#536579&quot;&gt;Invoice portal → AO detection and remediation → Developer Hub / agent → Forgejo PR + required check → AAP approval → same PDFs succeed.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#64748B;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">

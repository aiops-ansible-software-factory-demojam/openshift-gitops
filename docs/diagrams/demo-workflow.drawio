  <diagram id="nginx" name="03 nginx outage">
    <mxGraphModel dx="2100" dy="1320" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1320" math="0" shadow="0" background="#FFFFFF">

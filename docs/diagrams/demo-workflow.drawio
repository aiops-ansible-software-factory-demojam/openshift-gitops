        <mxCell id="shared-platform" value="&lt;div style=&quot;font-family:Arial;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#64748B;line-height:1.3&quot;&gt;SHARED MANAGEMENT PLANE ON OPENSHIFT&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:700;line-height:1.15;margin-top:9px;color:#172B40&quot;&gt;Homepage + SSO  •  AO  •  AAP + EDA  •  Developer Hub  •  Forgejo  •  Omnigent + Agent Sandbox  •  GitOps&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#64748B;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">

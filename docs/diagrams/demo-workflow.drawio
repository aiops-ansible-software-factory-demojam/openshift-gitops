        <mxCell id="prepare" value="Prepare once&#10;Select published refs → reset → bootstrap&#10;Verify baselines, model access and both EDA listeners" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F1F4F7;strokeColor=#91A0AE;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="190" width="800" height="125" />
        </mxCell>
        <mxCell id="n1" value="1  Trigger outage&#10;Enable SELinux Enforcing&#10;HTTP 403 → WebappDown" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="470" width="350" height="125" />
        </mxCell>
        <mxCell id="n2" value="2  Diagnose / author&#10;EDA → AO RCA → issue → EDA&#10;Developer Hub + coding agent" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="480" y="470" width="350" height="125" />
        </mxCell>
        <mxCell id="n3" value="3  Test / review&#10;Operator independently tests exact PR&#10;Fresh RHEL 9/10 → human merge" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFF3D6;strokeColor=#BC8B24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="880" y="470" width="350" height="125" />
        </mxCell>
        <mxCell id="n4" value="4  Recover / prove&#10;One webapp_nginx launch&#10;Enforcing, HTTP 200, alert resolved" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E9F5EC;strokeColor=#43885B;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1280" y="470" width="350" height="125" />
        </mxCell>
        <mxCell id="nginx-boundary" value="No native nginx approval graph&#10;Operator owns merge and recovery" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F1F4F7;strokeColor=#91A0AE;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1680" y="470" width="330" height="125" />
        </mxCell>
        <mxCell id="p1" value="1  Detect / route&#10;AAP dependency + business observation&#10;Lightwell discovery → app_patch" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="820" width="350" height="125" />
        </mxCell>
        <mxCell id="p2" value="2  Author / validate&#10;Issue → EDA → AO → coding PR&#10;Trusted independent RHEL acceptance" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="480" y="820" width="350" height="125" />
        </mxCell>
        <mxCell id="p3" value="3  Merge / approve&#10;Human Forgejo merge&#10;Native AAP production approval" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFF3D6;strokeColor=#BC8B24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="880" y="820" width="350" height="125" />
        </mxCell>
        <mxCell id="p4" value="4  Deploy / prove&#10;Reuse invoice_promote + exact SHA&#10;Verify release, behavior, close issue" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E9F5EC;strokeColor=#43885B;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">

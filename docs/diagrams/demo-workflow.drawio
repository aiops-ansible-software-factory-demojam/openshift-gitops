  <diagram id="preparation" name="02 Reset and prepare">
    <mxGraphModel dx="2100" dy="1320" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1320" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Prepare a fresh dual-application run" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=32;fontColor=#192E43;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="35" width="1980" height="55" />
        </mxCell>
        <mxCell id="subtitle" value="Do not trigger incidents during bootstrap. Preserve private configuration and evidence; explicitly select the coordinated source refs." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=17;fontColor=#526578;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="100" width="1980" height="58" />
        </mxCell>
        <mxCell id="footer" value="AIOps Ansible Software Factory | Current implementation: 2026-10-28 | AWS dual-app paths verified; CNV and alternative mitigation are separately qualified." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=12;fontColor=#526578;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1275" width="1980" height="24" />
        </mxCell>
        <mxCell id="refs" value="1  Select implementation&#10;Published GitOps + all companion refs&#10;See current-state table; seed defaults differ" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F1F4F7;strokeColor=#91A0AE;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="220" width="400" height="140" />
        </mxCell>
        <mxCell id="model" value="2  Verify both model consumers&#10;Endpoint / protocol / model access&#10;Keep all keys private" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F1EBFA;strokeColor=#8664AA;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="560" y="220" width="400" height="140" />
        </mxCell>
        <mxCell id="reset" value="3  Reset disposable state&#10;demo-reset --confirm-demo-reset&#10;Stop listeners; remove guests/disks/sessions" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1040" y="220" width="400" height="140" />
        </mxCell>
        <mxCell id="seed" value="4  Reseed / reconcile&#10;Forgejo source and credentials&#10;AAP/AO definitions; no starter incident" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1520" y="220" width="400" height="140" />
        </mxCell>
        <mxCell id="baseline" value="8  Verify live baselines&#10;nginx: Permissive + HTTP 200&#10;Python: vulnerable PyPDF2 + Enforcing" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E9F5EC;strokeColor=#43885B;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="510" width="400" height="140" />
        </mxCell>
        <mxCell id="apps" value="7  Deploy baseline apps&#10;invoice_baseline; nginx permissive setup&#10;webapp_nginx preserves the chosen mode" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="560" y="510" width="400" height="140" />
        </mxCell>
        <mxCell id="hosts" value="6  Provision distinct RHEL 9 hosts&#10;webapp_vm → webapps&#10;pythonapp_vm → pythonapps" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1040" y="510" width="400" height="140" />
        </mxCell>
        <mxCell id="bootstrap" value="5  Full bootstrap&#10;GitOps services + identity + AAP&#10;Scoped AWS / model / Lightwell material" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1520" y="510" width="400" height="140" />
        </mxCell>
        <mxCell id="ready" value="9  Require clean readiness&#10;No old incident PRs or coding sessions&#10;Both EDA listeners and source checks pass" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E9F5EC;strokeColor=#43885B;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="800" width="400" height="140" />
        </mxCell>
        <mxCell id="web-trigger" value="10a  Trigger nginx once&#10;aap launch webapp_selinux_enable&#10;Expect Enforcing / HTTP 403 / failed probe" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="560" y="800" width="400" height="140" />
        </mxCell>
        <mxCell id="invoice-trigger" value="10b  Trigger invoice detection&#10;make invoice-trigger BACKEND=aws&#10;Observe real dependency and business state" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1040" y="800" width="400" height="140" />
        </mxCell>
        <mxCell id="monitor" value="11  Follow both paths&#10;Separate issues, sessions, tests and results&#10;Do not modify live agent branches" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E9F5EC;strokeColor=#43885B;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1520" y="800" width="400" height="140" />
        </mxCell>

        <mxCell id="aap" value="Ansible Automation Platform&#10;Controller JTs + reusable native workflows&#10;EDA: alert and Forgejo event listeners&#10;Trusted validation + human approval" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">

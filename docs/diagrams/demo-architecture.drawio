          <mxGeometry as="geometry" x="1020" y="570" width="350" height="145" />
        </mxCell>
        <mxCell id="monitor" value="Monitoring / blackbox exporter&#10;Internal nginx HTTP probe → WebappDown&#10;Prometheus + Alertmanager&#10;Probe bypasses browser OIDC" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E9F5EC;strokeColor=#43885B;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="870" width="350" height="145" />
        </mxCell>
        <mxCell id="sandbox" value="Omnigent / managed Agent Sandboxes&#10;Separate author sessions and home volumes&#10;ADT + pinned provisioner + scoped test keys&#10;Source guard before publishing a PR" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="870" width="350" height="145" />
        </mxCell>
        <mxCell id="hub" value="Developer Hub / Backstage&#10;Allowlisted issue → contribution branch&#10;Golden-path template + internal feature gate" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#3977B7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">

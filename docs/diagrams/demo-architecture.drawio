        </mxCell>
        <mxCell id="web" value="PRODUCTION A | nginx · RHEL 9&#10;webapps / demo.webapp&#10;Fault: Permissive → Enforcing, HTTP 403&#10;Recovery: reviewed collection fix; Enforcing + HTTP 200" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E9F5EC;strokeColor=#43885B;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">

        </mxCell>
        <mxCell id="pipelines" value="OpenShift Pipelines&#10;Build sandbox / test execution image&#10;Track source commit and immutable digest" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F1F4F7;strokeColor=#91A0AE;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="1160" width="350" height="110" />
        </mxCell>
        <mxCell id="trust" value="Runtime material and access boundaries&#10;Kubernetes Secrets hold machine/model/test inputs. Bootstrap credentials stay local.&#10;Agent cannot rewrite trusted acceptance or approve/merge/deploy production.&#10;Application details live in collection vars; inventory resolves hosts and runtime access." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F1F4F7;strokeColor=#91A0AE;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">

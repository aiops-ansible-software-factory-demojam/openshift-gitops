        <mxCell id="python" value="PRODUCTION B | invoice portal · RHEL 9&#10;pythonapps / demo.pythonapp · SELinux Enforcing&#10;CVE-2023-36464: bounded PDF extraction timeout&#10;Recovery: exact approved Lightwell release + business checks" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E9F5EC;strokeColor=#43885B;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#192E43;" vertex="1" parent="1">

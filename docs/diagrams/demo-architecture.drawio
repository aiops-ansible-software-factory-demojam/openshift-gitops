        <mxCell id="aws-lifecycle-body" value="AAP provisions each application with separate purpose / security group.&#10;OpenShift Services + EndpointSlices provide stable guest endpoints.&#10;Scoped Molecule identity manages only disposable test resources.&#10;Reset removes application/test guests and disks; network is retained." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=18;fontColor=#263646;fontStyle=0;" vertex="1" parent="1">
